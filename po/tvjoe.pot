"  tvjoe --check [--dev]\n"
"  tvjoe --epg-add QUELLE          XMLTV-Datei oder -URL in die Einstellungen aufnehmen\n"
"  tvjoe --epg-check [QUELLE …]    Zuordnung der Sender zum EPG prüfen\n"
"  tvjoe --update-check            nach neuer Version auf GitHub fragen\n"
